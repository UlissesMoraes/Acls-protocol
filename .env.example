# Conteúdo remoto (Supabase) — opcional. Se ausente, usa os valores embutidos no app.
# A chave publishable é de leitura pública (protegida por RLS) e pode ser versionada.
VITE_SUPABASE_URL=https://rjexmjigzxyrpbuwlnur.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_QkRlpKhtxhl8iQkxOlLbiw_wgg2IH4w

# Desliga a busca remota (mantém só o conteúdo embutido): VITE_REMOTE_CONTENT=off
VITE_REMOTE_CONTENT=on

# ─── IA (Copiloto Clínico) ───────────────────────────────────────────────────
# IMPORTANTE: estas variáveis são lidas APENAS pela função serverless /api/ai.
# NÃO use o prefixo VITE_ — isso as exporia no bundle do navegador.
# Configure-as na Vercel em Project → Settings → Environment Variables.
OPENAI_API_KEY=sk-cole-sua-chave-secreta-aqui
# Modelo (opcional). Padrão: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# Restringe a origem que pode chamar a IA (opcional, recomendado em produção):
# AI_ALLOWED_ORIGIN=https://seu-app.vercel.app

# ─── Anamnese (área protegida com transcrição de áudio) ──────────────────────
# Senha de acesso à área de anamnese. Validada NO SERVIDOR a cada chamada paga
# (transcrição/análise). SEM prefixo VITE_ — nunca vai para o bundle do app.
ANAMNESE_PASSWORD=defina-uma-senha-forte
# Modelo de transcrição (opcional). Padrão: whisper-1
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ─── Painel de administrador (ver usuários cadastrados) ──────────────────────
# Chave SECRETA do Supabase (Project → Settings → API → service_role). SOMENTE no
# servidor — NUNCA com prefixo VITE_, nunca no front-end.
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-aqui
# Emails de administrador (separados por vírgula). Padrão: ulissessm15@gmail.com
ADMIN_EMAILS=ulissessm15@gmail.com
